Algoritmo Lecc10_Act2_Inc2
	Definir n, i Como Entero
	
    Escribir "Ingrese un número mayor a 2:"
    Leer n
    
    Escribir "Números pares comprendidos:"
    // Usamos 'Con Paso 2' para saltar directamente a los pares
    Para i = 2 Hasta n Con Paso 2 Hacer
        Escribir i
    Fin Para
	
FinAlgoritmo
